# PayPal sandbox app (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: webhook id for payout status updates
PAYPAL_WEBHOOK_ID=
# Optional: payout receiver and PayPal-login buyer for the demo (sandbox accounts)
HANDSHAKE_DEMO_FREELANCER_EMAIL=
HANDSHAKE_SANDBOX_BUYER_EMAIL=
HANDSHAKE_SANDBOX_BUYER_PASSWORD=
# AI: Claude API key (else the local `claude` CLI is used in development)
ANTHROPIC_API_KEY=
# Optional: higher GitHub API rate limit for PR/repo reviews
GITHUB_TOKEN=
